BALE_BOT_TOKEN=your_bale_bot_token
BALE_CHAT_ID=your_bale_chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional push (instant alerts, less battery than polling).
# Preferred: service-account JSON for FCM HTTP v1 (Firebase Console → Project
# settings → Service accounts → Generate new private key). Paste the whole JSON
# on one line. New Firebase projects have no legacy server key, so this is
# the path that works with your alert-87199 project.
FCM_SERVICE_ACCOUNT=
# Optional override; defaults to the JSON's project_id.
FCM_PROJECT_ID=
# Legacy fallback only (old Firebase projects):
FCM_SERVER_KEY=

# Journal — Google Drive (service account) — stores chart images uploaded from + New trade
# Drive-only; add more APIs via JOURNAL_PROVIDER (see README + js/journalProviders.mjs).
# Service accounts have NO My Drive quota → you MUST use a Shared Drive:
#   1) drive.google.com → Shared drives → New → name e.g. "Price-Alert"
#   2) Shared drive → Manage members → Add service account email (from JSON) as Manager
#   3) Open shared drive, copy ID from URL: https://drive.google.com/drive/folders/XXXX  → set below
#   4) Optional overrides below
# For .env: paste the whole JSON on ONE line, or base64-encode it — pretty-printed multi-line gets truncated to "{".
# More reliable locally: use GOOGLE_DRIVE_KEY_FILE instead of pasting.
GOOGLE_DRIVE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@...iam.gserviceaccount.com"}
GOOGLE_DRIVE_SHARED_DRIVE_ID=your-shared-drive-id
# GOOGLE_DRIVE_KEY_FILE=C:\keys\drive-key.json
# JOURNAL_DRIVE_FILENAME=price-alert-journal.json
# JOURNAL_PROVIDER=drive

# Only needed to register the Cloudflare Telegram webhook from your computer:
WORKER_URL=https://your-worker.your-subdomain.workers.dev
TELEGRAM_WEBHOOK_SECRET=
