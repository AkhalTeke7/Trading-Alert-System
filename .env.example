BALE_BOT_TOKEN=your_bale_bot_token
BALE_CHAT_ID=your_bale_chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional push (instant alerts, less battery than polling).
# Preferred: service-account JSON for FCM HTTP v1 (Firebase Console → Project
# settings → Service accounts → Generate new private key). Paste the whole JSON
# on one line. New Firebase projects have no legacy server key, so this is
# the path that works with your alert-87199 project.
FCM_SERVICE_ACCOUNT=
# Optional override; defaults to the JSON's project_id.
FCM_PROJECT_ID=
# Legacy fallback only (old Firebase projects):
FCM_SERVER_KEY=

# Journal is local-only — browser localStorage + JSON export.
# Export embeds images as compressed JPEG base64 (data:image/jpeg;base64,…)
# so the file is self-contained. No cloud needed.

# Only needed to register the Cloudflare Telegram webhook from your computer:
WORKER_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHAT_ID=
BALE_BOT_TOKEN=
BALE_CHAT_ID=
TWELVE_API_KEY=
FCM_SERVICE_ACCOUNT=
GOOGLE_DRIVE_SERVICE_ACCOUNT=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
DASHBOARD_USER=
DASHBOARD_PASSWORD=