<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pa_bg"
    android:orientation="horizontal">

    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="@color/pa_bone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/rowPair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="GOLD / USD"
            android:textColor="@color/pa_bone"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="2650 — note"
            android:textColor="@color/pa_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/rowTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="JUST NOW"
            android:textColor="@color/pa_dim"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
