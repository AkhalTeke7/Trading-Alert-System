<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pa_bone" />
            <stroke android:width="1dp" android:color="@color/pa_bone" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pa_red" />
            <stroke android:width="1dp" android:color="@color/pa_red" />
        </shape>
    </item>
</selector>
